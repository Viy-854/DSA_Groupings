using System;
using System.Collections.Generic;

class PostfixEvaluator
{
    static int EvaluatePostfix(string expression)
    {
        Stack<int> stack = new Stack<int>();

        foreach (char ch in expression)
        {
            // Skip whitespace
            if (char.IsWhiteSpace(ch))
                continue;

            // Operand: push the digit's numeric value
            if (char.IsDigit(ch))
            {
                stack.Push(ch - '0');
            }
            // Operator: pop two operands, apply, push result
            else
            {
                if (stack.Count < 2)
                    throw new InvalidOperationException("Invalid expression: not enough operands.");

                int right = stack.Pop();  // second operand
                int left = stack.Pop();   // first operand
                int result;

                switch (ch)
                {
                    case '+':
                        result = left + right;
                        break;
                    case '-':
                        result = left - right;
                        break;
                    case '*':
                        result = left * right;
                        break;
                    case '/':
                        if (right == 0)
                            throw new DivideByZeroException("Division by zero.");
                        result = left / right;
                        break;
                    default:
                        throw new ArgumentException($"Invalid operator: '{ch}'");
                }

                stack.Push(result);
            }
        }

        if (stack.Count != 1)
            throw new InvalidOperationException("Invalid expression: too many operands.");

        return stack.Pop();
    }

    static void Main()
    {
        Console.Write("Enter a postfix expression (single-digit operands, e.g. 231*+9-): ");
        string input = Console.ReadLine();

        try
        {
            int result = EvaluatePostfix(input);
            Console.WriteLine($"Result: {result}");
        }
        catch (DivideByZeroException ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        catch (ArgumentException ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        catch (InvalidOperationException ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}